# Copiar a `.env` para desarrollo local (`cp .env.example .env`) y completar
# los valores reales. En Railway, estas mismas claves se cargan como
# Variables del servicio (Settings > Variables) — NUNCA subiendo un .env.

# --- YouTube Data API v3 ---
# https://console.cloud.google.com/apis/credentials
# Sin esta clave, los colectores devuelven datos simulados (modo mock).
YOUTUBE_API_KEY=

# --- TikTok Research/Display API (opcional) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Base de datos ---
# Local: se puede dejar vacío/comentado, usa SQLite por default (cero
# infraestructura). En Railway: agregar el addon de PostgreSQL al proyecto
# y pegar acá la referencia a su variable, por ejemplo:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# Railway resuelve esa referencia al valor real (postgres://...) — el
# propio código de app/core/config.py lo reescribe a postgresql+asyncpg://.
# DATABASE_URL=sqlite+aiosqlite:///./channel_analytics.db

# --- Scheduler del worker de seguimiento (snapshot de canales YA trackeados) ---
# Corre todos los días por default ("*"). Sintaxis CronTrigger de
# APScheduler: "mon".."sun", "mon-fri", etc. si se prefiere una cadencia
# semanal en vez de diaria.
ENABLE_SCHEDULER=true
DAILY_JOB_DAY_OF_WEEK=*
DAILY_JOB_HOUR_UTC=9
DAILY_JOB_MINUTE_UTC=0

# --- Alta automática de canales nuevos (opcional) ---
# Job periódico independiente: descubre canales reales de todos los temas
# y los agrega solo al seguimiento (mismo camino que
# POST /tracking/discover-and-track), sin que nadie lo dispare a mano.
# Pensado para un proyecto de investigación con acceso real a las APIs —
# activarlo consume la cuota de YouTube de cada corrida (ver README,
# sección "Límites a tener en cuenta").
ENABLE_AUTO_DISCOVERY=false
AUTO_DISCOVERY_PLATFORM=all
AUTO_DISCOVERY_TOTAL_LIMIT=200
AUTO_DISCOVERY_SORT_BY=followers
AUTO_DISCOVERY_DAY_OF_WEEK=sun
AUTO_DISCOVERY_HOUR_UTC=8
AUTO_DISCOVERY_MINUTE_UTC=0

# --- Seguridad ---
# Protege POST/DELETE de /api/v1/tracking/* y /api/v1/auth/admin/set-plan
# con el header 'X-Admin-Token'. Vacío = sin protección (uso local).
# OBLIGATORIO poner un valor propio en Railway.
ADMIN_TOKEN=

# Firma los JWT de sesión. OBLIGATORIO sobreescribir este valor en Railway
# con un secreto propio — nunca dejar el default de desarrollo del código
# en un deploy público (ver app/core/config.py::JWT_SECRET_KEY).
JWT_SECRET_KEY=

# Gating real de planes de suscripción. false (default) = free/unica/
# mensual/premium quedan armados pero /analyze, /channels/* y /analytics/*
# no exigen sesión ni plan activo (igual que antes de sumar planes).
REQUIRE_SUBSCRIPTION=false
